{
  "name": "tableline",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "nodemon server/index.js",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node server/index.js",
    "seed": "node server/seed.js",
    "admin:create": "node server/create-admin.js",
    "db:init": "node server/initialize-local-rs.js"
  },
  "dependencies": {
    "@google/genai": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "mongoose": "^8.9.5",
    "multer": "^2.0.2",
    "nodemailer": "^10.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "mongodb-memory-server-core": "^11.3.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.3.2",
    "vite": "^6.0.7",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "protobufjs@7.6.6": true
  }
}
