NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/tableline?replicaSet=rs0
# Optional. Use only a dedicated disposable replica-set database for the integration tests.
MONGODB_TEST_URI=
# Replace with a unique random value of at least 32 characters.
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-chars
CLIENT_URL=http://localhost:5173

# Required to upload restaurant images. Keep these server-side only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Use database-ranked suggestions without an API key, or select gemini and add a key.
RECOMMENDATION_PROVIDER=demo
GEMINI_API_KEY=

# Optional SMTP delivery. In-app notifications work without these values.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional private inputs for `npm run admin:create` (also supported by local seed); never accepted by public registration.
ADMIN_EMAIL=
ADMIN_PASSWORD=
